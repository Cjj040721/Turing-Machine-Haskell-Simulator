cabal-version:      3.0
name:               coursework
version:            0.1.0.0
license:            BSD-3-Clause
license-file:       LICENSE
build-type:         Simple
extra-doc-files:    CHANGELOG.md

common warnings
    ghc-options:      -Wall -Wcompat -Widentities -Wincomplete-record-updates -Wincomplete-uni-patterns -Wmissing-export-lists -Wmissing-home-modules -Wpartial-fields -Wredundant-constraints

library
    import:           warnings
    exposed-modules:  Types, Parser, Tape, TM, Gui
    build-depends:    base >= 4.16 && < 4.22, gloss ^>=1.13, split ^>=0.2.3, directory ^>=1.3.7
    hs-source-dirs:   src
    default-language: Haskell2010

executable coursework
    import:           warnings
    main-is:          Main.hs
    build-depends: 
        base >= 4.16 && < 4.22,
        coursework,
        gloss ^>=1.13,
        split ^>=0.2.3,
        directory ^>=1.3.7
    hs-source-dirs:   app
    default-language: Haskell2010
    ghc-options:      -threaded -rtsopts -with-rtsopts=-N